{
  "name": "noema",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:client": "npm --workspace=client run dev",
    "dev:server": "npm --workspace=server run dev",
    "build": "npm --workspace=client run build && npm --workspace=server run build",
    "build-gh-page": "npm --workspace=client run build -- --outDir ../../docs --emptyOutDir",
    "test": "npm --workspace=client run test && npm --workspace=server run test",
    "generate-db": "npm --workspace=server run generate-db"
  },
  "license": "GPL-3.0-only",
  "workspaces": [
    "packages/client",
    "packages/server"
  ],
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "utility-types": "^3.11.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
